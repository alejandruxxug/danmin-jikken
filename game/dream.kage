//kage:unit pixels

package main

// The Prologue is a dream (Game Design -> design log): the picture is washed
// out and overexposed. Blacks are lifted to a light grey, the bright parts
// bleed a soft white glow, and a white haze creeps in from the edges. It runs
// on the finished picture, like the CRT, and only in the Prologue.
var Lift float // 0..1: how far black is lifted toward white
var Haze float // 0..1: how strong the white edge haze is

func Fragment(dstPos vec4, srcPos vec2, color vec4) vec4 {
	size := imageDstSize()
	uv := (dstPos.xy - imageDstOrigin()) / size // 0..1 over the picture
	c := imageSrc0At(srcPos).rgb

	// Bloom: the bright part of eight neighbours at two distances.
	glow := vec3(0)
	for i := 0; i < 8; i++ {
		a := float(i) * 0.785398 // 45 degrees apart
		d := vec2(cos(a), sin(a))
		glow += max(imageSrc0At(srcPos+d*3).rgb-0.6, 0)
		glow += max(imageSrc0At(srcPos+d*7).rgb-0.6, 0)
	}
	glow /= 16

	out := Lift + c*(1-Lift) // black becomes light grey, white stays white
	out += glow * 1.2
	edge := smoothstep(0.75, 1.35, length((uv-0.5)*vec2(1.6, 1.15))*1.5)
	out = mix(out, vec3(1), edge*Haze)
	return vec4(min(out, vec3(1)), 1)
}
